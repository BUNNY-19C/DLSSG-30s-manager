<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line front end over DLSSGManager.Core: the same library, deploy, restore and download
    code the window uses, for scripting and for CI smoke tests. Uses the same data folder
    (%APPDATA%\DLSSGManager, or DLSSGMANAGER_HOME).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>dlssgm</AssemblyName>
    <RootNamespace>DLSSGManager.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DLSSGManager.Core\DLSSGManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DLSSGManager.Core.Tests" />
  </ItemGroup>

</Project>
