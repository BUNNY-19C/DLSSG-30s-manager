<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DLSSGManager</AssemblyName>
    <RootNamespace>DLSSGManager</RootNamespace>
    <Product>DLSSG SM86 管理器</Product>
    <AssemblyTitle>DLSSG SM86 管理器</AssemblyTitle>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DLSSGManager.Core\DLSSGManager.Core.csproj" />
  </ItemGroup>

</Project>
