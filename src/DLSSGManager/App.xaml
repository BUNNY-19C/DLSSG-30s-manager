<Application x:Class="DLSSGManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DLSSGManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                主题字典。这里放的是默认（深色）主题；主窗口构造函数会按用户
                保存的偏好替换它。

                窗口和对话框都必须用 DynamicResource 引用这里的键——StaticResource
                在元素创建时解析一次，替换字典后不会重新查表，界面会停在旧配色上。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 下拉项的本地化内容（LocalizedString）按此模板显示：下拉框收起时展示的是选中项内容
                 本身，绑定到 Text 才能在切换语言时原地刷新。放在应用级，所有窗口共用。 -->
            <DataTemplate DataType="{x:Type loc:LocalizedString}">
                <TextBlock Text="{Binding Text}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
