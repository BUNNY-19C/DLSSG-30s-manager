<Window x:Class="DLSSGManager.GpuNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DLSSGManager"
        Title="{loc:Tr GpuName.Title}"
        SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <!--
        颜色全部走 DynamicResource。这个 Window 有自己的资源作用域，MainWindow 的
        隐式样式传不过来，所以按钮和输入框的模板要在这里重新定义。
    -->
    <Window.Resources>
        <Style x:Key="GpuButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GpuPrimaryButton" TargetType="Button" BasedOn="{StaticResource GpuButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GpuLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="GpuNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSection}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="{loc:Tr GpuName.Title}" FontSize="14" FontWeight="SemiBold" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr GpuName.Current}" Style="{StaticResource GpuLabel}" />
            <TextBlock x:Name="CurrentText" Grid.Column="1" TextWrapping="Wrap" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr GpuName.Real}" Style="{StaticResource GpuLabel}" />
            <TextBlock x:Name="RealText" Grid.Column="1" TextWrapping="Wrap" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr GpuName.New}" Style="{StaticResource GpuLabel}" />
            <TextBox x:Name="NameBox" Grid.Column="1" />
        </Grid>

        <TextBlock x:Name="NoteText" Style="{StaticResource GpuNote}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RestoreButton" Content="{loc:Tr GpuName.Restore}"
                    Style="{StaticResource GpuButton}" Margin="0,0,8,0" Click="Restore_Click" />
            <Button Content="{loc:Tr Common.Cancel}" Style="{StaticResource GpuButton}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ApplyButton" Content="{loc:Tr GpuName.Apply}" Style="{StaticResource GpuPrimaryButton}"
                    IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </StackPanel>
</Window>
