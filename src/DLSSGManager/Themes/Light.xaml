<!--
    浅色主题。键与 Dark.xaml 完全一致——切换时整个字典被替换，
    少一个键就会在切换后出现找不到资源的错误。

    状态色与强调色都比深色版更深：同样的绿/橙直接用在白底上对比度不足，
    文字和状态点会发虚。

    日志区在浅色主题下保持深色（终端惯例），所以 TextLogTitle / TextOnLog
    在这里是浅色值——它们落在 LogBackground 上，语义是"日志区内的文字"。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口与容器 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackground" Color="#F8F9FB" />
    <SolidColorBrush x:Key="LogBackground" Color="#17191D" />
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF" />

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D5DAE0" />

    <!-- 分隔线与悬停 -->
    <SolidColorBrush x:Key="LineBrush" Color="#E6E9ED" />
    <SolidColorBrush x:Key="HoverBackground" Color="#EEF0F3" />
    <SolidColorBrush x:Key="ListHoverBackground" Color="#F3F5F7" />
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#E9F5DC" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#191C20" />
    <SolidColorBrush x:Key="TextMuted" Color="#5A626C" />
    <SolidColorBrush x:Key="TextFaint" Color="#828B95" />
    <SolidColorBrush x:Key="TextSection" Color="#5D6670" />
    <SolidColorBrush x:Key="TextLogTitle" Color="#D2D8DE" />
    <SolidColorBrush x:Key="TextOnLog" Color="#B0B8C0" />

    <!-- 强调色与按钮：白底上主色仍用 RTX 绿（黑字按钮），链接/选中等文字场景用深绿 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5E9400" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D5DAE0" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#76B900" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#76B900" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#69A800" />
    <SolidColorBrush x:Key="OnPrimaryText" Color="#0C0F0A" />
    <SolidColorBrush x:Key="DangerBackground" Color="#FCEDEE" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0C5C7" />
    <SolidColorBrush x:Key="DangerText" Color="#B3353D" />

    <!-- 徽章 -->
    <SolidColorBrush x:Key="BadgeOkBackground" Color="#E4F5E6" />
    <SolidColorBrush x:Key="BadgeOkText" Color="#1F7A38" />
    <SolidColorBrush x:Key="BadgeWarnBackground" Color="#FBF2D9" />
    <SolidColorBrush x:Key="BadgeWarnText" Color="#7A5F14" />

    <!-- 反作弊警告横幅 -->
    <SolidColorBrush x:Key="WarnBannerBackground" Color="#FBF2D9" />
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#E2C87C" />
    <SolidColorBrush x:Key="WarnBannerTitle" Color="#7A5F14" />
    <SolidColorBrush x:Key="WarnBannerBody" Color="#6E5B2E" />

    <!-- 游戏状态指示 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2F9E44" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#B08A1E" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#C93B43" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#98A1AB" />

</ResourceDictionary>
