<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Harness</AssemblyName>
    <RootNamespace>DLSSGManager</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- 刻意不使用 UseWPF：本测试工具是控制台程序，只用依赖 Windows 的注册表与 P/Invoke。
         引入 WPF 会要求 CI 安装额外的桌面 SDK 组件，而这里并不需要。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DLSSGManager\Models.cs" />
    <Compile Include="..\..\src\DLSSGManager\Palette.cs" />
    <Compile Include="..\..\src\DLSSGManager\ThemeKeys.cs" />
    <Compile Include="..\..\src\DLSSGManager\Version.cs" />
    <Compile Include="..\..\src\DLSSGManager\Localization.cs" />
    <Compile Include="..\..\src\DLSSGManager\Strings.cs" />
    <Compile Include="..\..\src\DLSSGManager\Strings.zh.cs" />
    <Compile Include="..\..\src\DLSSGManager\Strings.en.cs" />
    <Compile Include="..\..\src\DLSSGManager\LocalizationAudit.cs" />
    <Compile Include="..\..\src\DLSSGManager\Store.cs" />
    <Compile Include="..\..\src\DLSSGManager\Native.cs" />
    <Compile Include="..\..\src\DLSSGManager\ModSource.cs" />
    <Compile Include="..\..\src\DLSSGManager\ModSourceLocator.cs" />
    <Compile Include="..\..\src\DLSSGManager\Shell.cs" />
    <Compile Include="..\..\src\DLSSGManager\ModFetcher.cs" />
    <Compile Include="..\..\src\DLSSGManager\DeploymentService.cs" />
    <Compile Include="..\..\src\DLSSGManager\AntiCheat.cs" />
    <Compile Include="..\..\src\DLSSGManager\Detection.cs" />
    <Compile Include="..\..\src\DLSSGManager\Gpu.cs" />
  </ItemGroup>

</Project>
